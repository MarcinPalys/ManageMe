# Google OAuth (wymagane do logowania)
VITE_GOOGLE_CLIENT_ID=

# E-mail pierwszego admina – dostaje rolę 'admin' przy pierwszym logowaniu
VITE_SUPER_ADMIN_EMAIL=

# ---------------------------------------------------------------
# Wybór backendu danych: 'localStorage' (domyślnie) lub 'firestore'
# ---------------------------------------------------------------
VITE_STORAGE_BACKEND=localStorage

# ---------------------------------------------------------------
# Firebase / Firestore – wymagane tylko gdy VITE_STORAGE_BACKEND=firestore
#
# Jak skonfigurować:
#   1. Wejdź na https://console.firebase.google.com i utwórz projekt
#   2. Przejdź do Project Settings > General > Your apps > Add app (Web)
#   3. Skopiuj wartości z obiektu firebaseConfig poniżej
#   4. W Firebase Console przejdź do Firestore Database > Create database
#   5. Dla trybu testowego wybierz "Start in test mode" (ważne: 30-dniowy limit)
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
